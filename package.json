function preprocess(query) {
  return query.toLowerCase()
    .replace(/[.,!?;:'"()]/g, "")
    .split(/\s+/)
    .filter(t => t && !STOPWORDS.has(t))
    .map(t => MISSPELLINGS[t] || t);
}

function buildTFIDF(docs) {
  const tokenized = docs.map(preprocess);
  const N = tokenized.length;
  const df = {};
  tokenized.forEach(toks => [...new Set(toks)].forEach(t => df[t] = (df[t]||0)+1));
  const idf = {};
  Object.entries(df).forEach(([t,f]) => idf[t] = Math.log((N+1)/(f+1))+1);
  const matrix = tokenized.map(toks => {
    const total = Math.max(toks.length, 1);
    const tf = {};
    toks.forEach(t => tf[t] = (tf[t]||0)+1);
    const vec = {};
    Object.entries(tf).forEach(([t,c]) => vec[t] = (c/total)*(idf[t]||0));
    return vec;
  });
  return { matrix, idf };
}

function cosine(a, b) {
  const common = Object.keys(a).filter(k => b[k]);
  if (!common.length) return 0;
  const dot = common.reduce((s,k) => s + a[k]*b[k], 0);
  const magA = Math.sqrt(Object.values(a).reduce((s,v)=>s+v*v,0));
  const magB = Math.sqrt(Object.values(b).reduce((s,v)=>s+v*v,0));
  return (magA && magB) ? dot/(magA*magB) : 0;
}

const faqDocs     = Object.keys(EXTENDED_FAQ);
const faqAnswers  = Object.values(EXTENDED_FAQ);
const { matrix: tfidfMatrix, idf: globalIdf } = buildTFIDF(faqDocs);

function classifyIntent(query) {
  const tokens = preprocess(query);
  const scores = {};
  tokens.forEach(t => {
    Object.entries(INTENT_PATTERNS).forEach(([intent, kws]) => {
      if (kws.includes(t)) scores[intent] = (scores[intent]||0)+1;
    });
  });
  const best = Object.entries(scores).sort((a,b)=>b[1]-a[1])[0];
  return best ? best[0] : "general";
}

function extractEntities(query) {
  const entities = { courses:[], semesters:[], years:[] };
  ["CS","IT","EC","ME","CE","EE","AI","DS"].forEach(c => {
    if (new RegExp(`\\b${c}\\b`,'i').test(query)) entities.courses.push(c);
  });
  const semMatch = query.match(/\b(sem|semester)\s*(\d{1,2})\b/i);
  if (semMatch) entities.semesters.push(`Semester ${semMatch[2]}`);
  const yearMatch = query.match(/\b(first|second|third|fourth|1st|2nd|3rd|4th)\s+year\b/i);
  if (yearMatch) entities.years.push(yearMatch[0]);
  return entities;
}

function queryVector(tokens) {
  const total = Math.max(tokens.length, 1);
  const tf = {};
  tokens.forEach(t => tf[t] = (tf[t]||0)+1);
  const vec = {};
  Object.entries(tf).forEach(([t,c]) => vec[t] = (c/total)*(globalIdf[t]||0));
  return vec;
}

let clarCounter = 0;
function chat(query, lastIntent) {
  const tokens = preprocess(query);
  if (!tokens.length) return { text:"Please type a question.", intent:"general", confidence:0, entities:{} };

  // synonym shortcut
  for (const t of tokens) {
    if (TOKEN_TO_KEY[t]) {
      const key = TOKEN_TO_KEY[t];
      const answer = FAQ_DB[key];
      if (answer) {
        clarCounter = 0;
        const intent = classifyIntent(query);
        return { text: answer, intent, confidence: 0.85, entities: extractEntities(query) };
      }
    }
  }

  const qVec = queryVector(tokens);
  let bestScore = -1, bestIdx = -1;
  tfidfMatrix.forEach((dv, i) => {
    const s = cosine(qVec, dv);
    if (s > bestScore) { bestScore = s; bestIdx = i; }
  });

  const intent = classifyIntent(query);
  const entities = extractEntities(query);

  if (bestScore >= 0.1 && bestIdx >= 0) {
    clarCounter = 0;
    return { text: faqAnswers[bestIdx], intent, confidence: bestScore, entities };
  }

  clarCounter++;
  if (clarCounter >= 2) {
    clarCounter = 0;
    const contact = HANDOVER[intent] || HANDOVER.general;
    return {
      text: `I'm having trouble with that question. Please reach out to a human advisor:\n\n${contact}`,
      intent, confidence: 0, entities, isHandover: true,
    };
  }

  return {
    text: "I'm not sure I understood that. Could you rephrase? Try asking about fees, exams, hostel, admissions, or timetables.",
    intent, confidence: 0, entities, isClarification: true,
  };
}

// ── Helpers ─────────────────────────────────────────────────────────────────

function formatTime(date) {
  return date.toLocaleTimeString([], { hour:"2-digit", minute:"2-digit" });
}

function formatBubbleText(text) {
  // strip entity/match tags for display, keep clean
  return text.replace(/\[Entities →.*?\]\n?/g, "").replace(/\[Match: [\d.]+\]\s?/g, "").trim();
}

const SUGGESTIONS = [
  "What are the college fees?",
  "When are the exams?",
  "Is there hostel facility?",
  "How do I apply for a scholarship?",
  "What are the library hours?",
  "How do I connect to WiFi?",
];

const QUICK_LINKS = [
  { icon:"💰", label:"Fees & Payments",  q:"What are the college fees?" },
  { icon:"📅", label:"Exam Schedule",    q:"When are the exams scheduled?" },
  { icon:"🏠", label:"Hostel Info",      q:"Is hostel facility available?" },
  { icon:"📚", label:"Library Hours",    q:"What are the library hours?" },
  { icon:"🎓", label:"Admissions",       q:"When do admissions open?" },
  { icon:"🌐", label:"WiFi Access",      q:"How do I connect to WiFi?" },
];

// ── Component ────────────────────────────────────────────────────────────────

export default function ChatbotApp() {
  const [messages, setMessages]     = useState([]);
  const [input, setInput]           = useState("");
  const [typing, setTyping]         = useState(false);
  const [showAnalytics, setShowAnalytics] = useState(false);
  const [analytics, setAnalytics]   = useState({ total:0, unresolved:0, intents:{} });
  const [lastIntent, setLastIntent] = useState("general");

  const messagesEndRef = useRef(null);
  const textareaRef    = useRef(null);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior:"smooth" });
  }, [messages, typing]);

  function updateAnalytics(intent, confidence) {
    setAnalytics(prev => ({
      total: prev.total + 1,
      unresolved: confidence < 0.1 ? prev.unresolved + 1 : prev.unresolved,
      intents: { ...prev.intents, [intent]: (prev.intents[intent]||0)+1 },
    }));
  }

  function sendMessage(text) {
    const q = (text || input).trim();
    if (!q) return;

    setMessages(prev => [...prev, {
      role:"user", text: q, time: new Date(),
    }]);
    setInput("");
    setTyping(true);

    setTimeout(() => {
      const result = chat(q, lastIntent);
      setTyping(false);
      setLastIntent(result.intent);
      updateAnalytics(result.intent, result.confidence);

      setMessages(prev => [...prev, {
        role:"bot",
        text: formatBubbleText(result.text),
        intent: result.intent,
        confidence: result.confidence,
        entities: result.entities,
        isHandover: result.isHandover,
        isClarification: result.isClarification,
        time: new Date(),
      }]);
    }, 700 + Math.random()*400);
  }

  function handleKey(e) {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  }

  const topIntents = Object.entries(analytics.intents)
    .sort((a,b)=>b[1]-a[1]).slice(0,5);
  const maxCount = topIntents[0]?.[1] || 1;

  return (
    <>
      <style>{css}</style>
      <div className="app">

        {/* ── SIDEBAR ── */}
        <aside className="sidebar">
          <div className="sidebar-header">
            <div className="logo">
              <div className="logo-icon">🎓</div>
              <div className="logo-text">
                <h1>InstituteBot</h1>
                <span>Academic Assistant</span>
              </div>
            </div>
            <div className="status-pill">
              <div className="status-dot" />
              Online · Weeks 1–10
            </div>
          </div>

          <div className="sidebar-section">
            <div className="sidebar-section-title">Quick Topics</div>
            {QUICK_LINKS.map(l => (
              <button key={l.label} className="quick-btn" onClick={() => sendMessage(l.q)}>
                <span className="qicon">{l.icon}</span>
                {l.label}
              </button>
            ))}
          </div>

          <div className="sidebar-divider" />

          <div className="sidebar-section">
            <div className="sidebar-section-title">Tools</div>
            <button className="quick-btn" onClick={() => setShowAnalytics(true)}>
              <span className="qicon">📊</span> Analytics Report
            </button>
            <button className="quick-btn" onClick={() => { setMessages([]); clarCounter=0; }}>
              <span className="qicon">🔄</span> Clear Chat
            </button>
          </div>

          <div className="sidebar-footer">
            <div className="week-badge">
              <div>
                <div className="week-badge-label">Current Build</div>
                <div className="week-badge-value">February · Week 10</div>
              </div>
              <span style={{fontSize:22}}>🏗️</span>
            </div>
          </div>
        </aside>

        {/* ── MAIN ── */}
        <main className="main">
          <div className="topbar">
            <div className="topbar-left">
              <div className="topbar-avatar">🤖</div>
              <div>
                <div className="topbar-title">FAQ Assistant</div>
                <div className="topbar-sub">
                  {typing ? "Thinking…" : `${analytics.total} messages · ${analytics.unresolved} unresolved`}
                </div>
              </div>
            </div>
            <div className="topbar-actions">
              <button className="icon-btn" title="Analytics" onClick={() => setShowAnalytics(true)}>📊</button>
              <button className="icon-btn" title="Clear" onClick={() => { setMessages([]); clarCounter=0; }}>🗑️</button>
            </div>
          </div>

          <div className="messages-area">
            {messages.length === 0 && !typing && (
              <div className="welcome-block">
                <div className="welcome-icon">🎓</div>
                <h2>Ask me anything<br/>about your institute</h2>
                <p>I can help with fees, exams, hostel, admissions, timetables, scholarships, and more.</p>
                <div className="suggestion-chips">
                  {SUGGESTIONS.map(s => (
                    <button key={s} className="chip" onClick={() => sendMessage(s)}>{s}</button>
                  ))}
                </div>
              </div>
            )}

            {messages.map((msg, i) => (
              <div key={i} className={`message-row ${msg.role}`}>
                <div className={`msg-avatar ${msg.role}`}>
                  {msg.role === "bot" ? "🤖" : "👤"}
                </div>
                <div className="msg-body">
                  {msg.role === "bot" && msg.intent && msg.intent !== "general" && (
                    <span className="intent-badge">🏷 {msg.intent}</span>
                  )}
                  {msg.role === "bot" && msg.entities && (
                    <>
                      {msg.entities.courses?.map(c => (
                        <span key={c} className="tag-pill">📖 {c}</span>
                      ))}
                      {msg.entities.semesters?.map(s => (
                        <span key={s} className="tag-pill">📆 {s}</span>
                      ))}
                    </>
                  )}
                  <div className={`bubble ${msg.role}`}>{msg.text}</div>
                  <div className="bubble-meta">
                    {formatTime(msg.time)}
                    {msg.role === "bot" && msg.confidence > 0 &&
                      ` · ${Math.round(msg.confidence*100)}% match`}
                  </div>
                </div>
              </div>
            ))}

            {typing && (
              <div className="typing-row">
                <div className="msg-avatar bot">🤖</div>
                <div className="typing-bubble">
                  <div className="dot" /><div className="dot" /><div className="dot" />
                </div>
              </div>
            )}

            <div ref={messagesEndRef} />
          </div>

          {/* Input */}
          <div className="input-area">
            <div className="input-wrapper">
              <textarea
                ref={textareaRef}
                className="chat-input"
                rows={1}
                placeholder="Ask about fees, exams, hostel, admissions…"
                value={input}
                onChange={e => setInput(e.target.value)}
                onKeyDown={handleKey}
              />
              <button className="send-btn" disabled={!input.trim() || typing} onClick={() => sendMessage()}>
                ➤
              </button>
            </div>
            <div className="input-hint">Press Enter to send · Shift+Enter for new line</div>
          </div>
        </main>

        {/* ── ANALYTICS OVERLAY ── */}
        {showAnalytics && (
          <div className="analytics-overlay" onClick={() => setShowAnalytics(false)}>
            <div className="analytics-panel" onClick={e => e.stopPropagation()}>
              <h3>📊 Analytics Report</h3>
              <div className="stat-grid">
                <div className="stat-card">
                  <div className="stat-value">{analytics.total}</div>
                  <div className="stat-label">Total messages</div>
                </div>
                <div className="stat-card">
                  <div className="stat-value">{analytics.unresolved}</div>
                  <div className="stat-label">Unresolved queries</div>
                </div>
                <div className="stat-card">
                  <div className="stat-value">
                    {analytics.total ? Math.round((1 - analytics.unresolved/analytics.total)*100) : 100}%
                  </div>
                  <div className="stat-label">Resolution rate</div>
                </div>
                <div className="stat-card">
                  <div className="stat-value">{Object.keys(analytics.intents).length}</div>
                  <div className="stat-label">Intent types seen</div>
                </div>
              </div>

              {topIntents.length > 0 && (
                <>
                  <div style={{fontSize:12,color:"var(--muted)",marginBottom:10,textTransform:"uppercase",letterSpacing:"0.08em"}}>
                    Top Intents
                  </div>
                  {topIntents.map(([intent, count]) => (
                    <div key={intent} className="intent-bar-row">
                      <div className="intent-name">{intent}</div>
                      <div className="intent-track">
                        <div className="intent-fill" style={{width:`${(count/maxCount)*100}%`}} />
                      </div>
                      <div className="intent-count">{count}</div>
                    </div>
                  ))}
                </>
              )}

              <button className="close-btn" onClick={() => setShowAnalytics(false)}>Close</button>
            </div>
          </div>
        )}
      </div>
    </>
  );
}
